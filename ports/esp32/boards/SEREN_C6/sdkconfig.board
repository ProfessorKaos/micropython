# Extra size trims to fit the firmware in the OTA partition on 4MiB flash.

# Remove PPP support.
CONFIG_LWIP_PPP_SUPPORT=n
CONFIG_LWIP_PPP_PAP_SUPPORT=n
CONFIG_LWIP_PPP_CHAP_SUPPORT=n

# Remove SPI Ethernet drivers.
CONFIG_ETH_USE_SPI_ETHERNET=n
CONFIG_ETH_SPI_ETHERNET_W5500=n
CONFIG_ETH_SPI_ETHERNET_KSZ8851SNL=n
CONFIG_ETH_SPI_ETHERNET_DM9051=n

CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_ENABLE_SAE_H2E=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
